# Copy this file to `.env` and paste your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required for identity-linked (user) API keys. Find it in the Console under
# Organization settings > Workspaces - the id looks like wrkspc_01AbC...
ANTHROPIC_WORKSPACE_ID=

# Optional: swap the model. Default is claude-haiku-4-5 (cheapest).
# Switch to claude-opus-5 if Haiku misreads your documents — roughly 6x the cost.
# RENEWLY_MODEL=claude-opus-5
