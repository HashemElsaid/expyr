{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expyr",
      "url": "http://localhost:8081",
      "port": 8081
    },
    {
      "name": "expyr-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081", "--offline"],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "expyr-phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--port", "8081"],
      "port": 8081,
      "autoPort": false
    }
  ]
}
